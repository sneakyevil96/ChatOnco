# Local-development values only. Never reuse these credentials in staging or production.
APP_ENV=local
LOG_LEVEL=INFO

POSTGRES_DB=screening_platform
POSTGRES_USER=screening_local
POSTGRES_PASSWORD=local-development-only
DATABASE_URL=postgresql+psycopg://screening_local:local-development-only@postgres:5432/screening_platform

PROJECT_CONFIG_DIR=/workspace/backend/config/projects
WHATSAPP_PROVIDER=mock
# Real Meta delivery remains disabled until onboarding. When enabled, mount a
# deployment-owned secret file and set an explicitly reviewed Graph API version.
# WHATSAPP_SECRET_FILE=/run/secrets/whatsapp_bindings.json
# META_GRAPH_API_VERSION=<reviewed-version>
# META_GRAPH_API_BASE_URL=https://graph.facebook.com
# Keep the lightweight target until FAQ embedding/calibration work begins.
# Use development-embeddings to install the local CPU sentence-transformer stack.
BACKEND_BUILD_TARGET=development

# Local-only security keys. Generate independent random values for every deployed environment.
CSRF_SIGNING_KEY=local-csrf-signing-key-change-before-deployment
SECURITY_HASH_KEY=local-security-hash-key-change-before-deployment
ALLOWED_BROWSER_ORIGINS=http://localhost:8080,http://localhost:5173

# Local operational defaults. Production must use a restricted panel access
# mode and documented MFA risk acceptance until MFA is implemented.
OPERATOR_PANEL_ACCESS_MODE=public
RESTRICTED_PANEL_MFA_RISK_ACCEPTED=false
API_DOCS_ENABLED=true
STRUCTURED_LOGGING=true
RETENTION_BATCH_SIZE=1000
SECURITY_STATE_CLEANUP_DAYS=30
OPERATIONS_STALE_OUTBOX_MINUTES=5

# Production-readiness confirmations are intentionally false until verified on
# the actual server by the responsible team.
HTTPS_TERMINATION_CONFIRMED=false
STORAGE_ENCRYPTION_CONFIRMED=false
BACKUP_ENCRYPTION_CONFIRMED=false
BACKUP_DESTINATION_SEPARATE_CONFIRMED=false
BACKUP_RESTORE_TEST_CONFIRMED=false
