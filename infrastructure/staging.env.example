# Synthetic-data staging only. Copy outside Git and replace every placeholder.
STAGING_HOST=staging.example.invalid
STAGING_LOG_LEVEL=INFO

STAGING_POSTGRES_DB=screening_staging
STAGING_POSTGRES_USER=screening_staging
STAGING_POSTGRES_PASSWORD_FILE=/etc/screening-platform/staging/postgres-password
STAGING_APPLICATION_SECRET_FILE=/etc/screening-platform/staging/application.json

# Keep mock until a separately approved non-production Meta configuration exists.
STAGING_WHATSAPP_PROVIDER=mock
STAGING_PANEL_ACCESS_MODE=public
