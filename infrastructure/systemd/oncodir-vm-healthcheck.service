[Unit]
Description=ONCODIR/ONCOSCREEN synthetic VM health check
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/bin/sh /opt/oncodir-oncoscreen/infrastructure/scripts/check-vm-test-health.sh
User=root
Group=root
Environment=DOCKER_CONFIG=/tmp/docker-config
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadOnlyPaths=/opt/oncodir-oncoscreen /etc/oncodir-oncoscreen/vm-test

[Install]
WantedBy=multi-user.target
