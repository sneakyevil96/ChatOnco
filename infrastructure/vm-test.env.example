# Synthetic VM test only. The preparation script writes the deployment-owned
# version under /etc/oncodir-oncoscreen/vm-test without placing secrets in Git.
VM_TEST_BIND_ADDRESS=127.0.0.1
VM_TEST_PORT=8080
VM_TEST_LOG_LEVEL=INFO
VM_TEST_POSTGRES_PASSWORD_FILE=/etc/oncodir-oncoscreen/vm-test/postgres-password
VM_TEST_APPLICATION_SECRET_FILE=/etc/oncodir-oncoscreen/vm-test/application.json
